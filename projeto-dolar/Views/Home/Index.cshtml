@{
    ViewData["Title"] = "Unlock Your Metabolic Power";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <!-- CSS CORRETO -->
    <link rel="stylesheet" href="/css/site.css">
</head>
<body>

    <!-- HERO -->
    <section class="hero">
        <div class="hero-content">
            <h1>Unlock Your Metabolic Power</h1>
            <p>
                Support your metabolism naturally and feel confident, energized,
                and in control of your body again.
            </p>
            <a href="#cta" class="btn-primary">Discover How It Works</a>
        </div>
        <div class="hero-image">
            <img src="/images/hero.jpg" alt="Confident healthy woman">
        </div>
    </section>

    <!-- BENEFITS -->
    <section class="benefits">
        <h2>Why Women Choose This Metabolic Support</h2>

        <div class="benefit-list">
            <div class="benefit">
                <h3>🔥 Boost Metabolism</h3>
                <p>Helps activate natural metabolic processes.</p>
            </div>

            <div class="benefit">
                <h3>⚡ More Daily Energy</h3>
                <p>Feel lighter, focused, and active throughout the day.</p>
            </div>

            <div class="benefit">
                <h3>❤️ Hormone-Friendly</h3>
                <p>Designed with the female body in mind.</p>
            </div>
        </div>
    </section>

    <!-- IMAGE SECTION -->
    <section class="image-section">
        <img src="/images/woman-energy.jpg" alt="Woman with energy">
        <img src="/images/supplement.jpg" alt="Metabolic supplement bottle">
    </section>

    <!-- CTA -->
    <section class="cta" id="cta">
        <h2>Start Your Metabolic Reset Today</h2>
        <p>
            This simple daily habit is helping thousands of women feel lighter,
            more confident, and more energized.
        </p>
        <a href="https://SEU-LINK-AQUI.com" class="btn-primary">Get Started Now</a>
    </section>

</body>
</html>
