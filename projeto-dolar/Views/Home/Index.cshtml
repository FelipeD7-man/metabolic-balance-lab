            <div class="why-item">🧪 <strong>Science-Backed</strong><br>Carefully selected ingredients.</div>
        </div>

        <a class="btn-secondary"
           href="https://mitolyn.com/welcome/?hop=felipedia&hopId=77433839-8522-4bd2-b3d0-cd39e591939e"
           target="_blank">
            Try Mitolyn Today
        </a>
    </section>

    <!-- PRODUCT -->
    <section class="product">
        <div class="product-image">
            <img src="/images/mitolyn-bottle.png" alt="Mitolyn bottle">
        </div>

        <div class="product-text">
            <h2>Metabolic & Hormone Support</h2>
            <p>
                A simple daily habit helping thousands of women
                regain control of their metabolism.
            </p>
