    <!-- CONFIDENCE -->
    <section class="confidence">
        <img src="/images/woman-confident.jpg" alt="Confident woman">

        <h2>Start Your Metabolic Reset Today</h2>
        <p>
            This simple routine is helping women feel lighter,
            more energized, and more confident.
        </p>

        <a class="btn-primary"
           href="https://mitolyn.com/welcome/?hop=felipedia&hopId=77433839-8522-4bd2-b3d0-cd39e591939e"
           target="_blank">
