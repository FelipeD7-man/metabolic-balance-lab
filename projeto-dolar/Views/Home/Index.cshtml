        </div>
    </section>

    <!-- LIFESTYLE -->
    <section class="lifestyle">
        <div class="lifestyle-text">
            <h2>Feel Better Every Day</h2>
            <p>
                Thousands of women are supporting their metabolism daily
                and finally feeling good in their own bodies again.
            </p>
        </div>

        <div class="lifestyle-image">
            <img src="/images/lifestyle-woman.jpg" alt="Healthy lifestyle woman">
        </div>
    </section>

    <!-- CONFIDENCE -->
    <section class="confidence">
        <img src="/images/woman-confident.jpg" alt="Confident woman">

        <h2>Start Your Metabolic Reset Today</h2>
        <p>
            This simple daily habit is helping women feel lighter,
            more energized, and more confident.
        </p>

        <a href="https://mitolyn.com/welcome/?hop=felipedia&hopId=77433839-8522-4bd2-b3d0-cd39e591939e"
